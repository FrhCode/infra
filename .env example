# Copy to .env.infra on the VPS. Do not commit real .env.infra.

# Bind shared infrastructure ports to localhost so only host Caddy / local Docker clients can reach them.
INFRA_BIND_HOST=0.0.0.0
POSTGRES_PORT=5432
REDIS_PORT=6379
LANGFUSE_PORT=3045
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
SHARED_INFRA_NETWORK=shared-infra

# PostgreSQL admin bootstrap user. Use this only for administering per-app DBs/users.
POSTGRES_USER=infra_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=postgres

# Redis shared instance. App URLs should include this password.
REDIS_PASSWORD=CHANGE_ME

# Langfuse shared observability instance. Create langfuse_prod/langfuse_user in PostgreSQL first.
LANGFUSE_DATABASE_URL=postgresql://langfuse_user:CHANGE_ME@postgres:5432/langfuse_prod
LANGFUSE_PUBLIC_URL=https://staging-langfuse.kariraksi.com
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME
LANGFUSE_SALT=CHANGE_ME
LANGFUSE_TELEMETRY_ENABLED=false
LANGFUSE_AUTH_DISABLE_SIGNUP=true

# RUSTFS S3
RUSTFS_ACCESS_KEY=root
RUSTFS_SECRET_KEY=CHANGE_ME
RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS=*
RUSTFS_OBS_LOGGER_LEVEL=info
RUSTFS_UNSAFE_BYPASS_DISK_CHECK=false