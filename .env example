# Copy to .env.infra on the VPS. Do not commit real .env.infra.

# Bind shared infrastructure ports to localhost so only host Caddy / local Docker clients can reach them.
INFRA_BIND_HOST=0.0.0.0
POSTGRES_PORT=5432
REDIS_PORT=6379
LANGFUSE_PORT=3045
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
SHARED_INFRA_NETWORK=shared-infra

# PostgreSQL admin bootstrap user. Use this only for administering per-app DBs/users.
POSTGRES_USER=infra_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=postgres

# Redis shared instance. App URLs should include this password.
REDIS_PASSWORD=CHANGE_ME

# Langfuse shared observability instance. Create langfuse_prod/langfuse_user in PostgreSQL first.
LANGFUSE_DATABASE_URL=postgresql://langfuse_user:CHANGE_ME@postgres:5432/langfuse_prod
LANGFUSE_PUBLIC_URL=https://staging-langfuse.kariraksi.com
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME
LANGFUSE_SALT=CHANGE_ME
LANGFUSE_TELEMETRY_ENABLED=false
LANGFUSE_AUTH_DISABLE_SIGNUP=true

# RUSTFS S3
RUSTFS_ACCESS_KEY=root
RUSTFS_SECRET_KEY=CHANGE_ME
RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS=*
RUSTFS_OBS_LOGGER_LEVEL=info
RUSTFS_UNSAFE_BYPASS_DISK_CHECK=false

# ============================================================
# Firecrawl
# ============================================================

# Port exposed on the server
FIRECRAWL_PORT=3002

# Internal Firecrawl container port
FIRECRAWL_INTERNAL_PORT=3002

FIRECRAWL_ENV=local

FIRECRAWL_LOGGING_LEVEL=info


# ============================================================
# Firecrawl Authentication
# ============================================================

# Leave false for now.
# Setting this true alone is NOT enough to configure auth.
FIRECRAWL_USE_DB_AUTHENTICATION=false


# ============================================================
# Firecrawl Redis
#
# Reuses your existing shared Redis.
#
# DB 0 = your existing/default apps
# DB 1 = Firecrawl
# DB 2 = Firecrawl rate limiter
# ============================================================

FIRECRAWL_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/1

FIRECRAWL_REDIS_RATE_LIMIT_URL=redis://:${REDIS_PASSWORD}@redis:6379/2


# ============================================================
# Firecrawl NuQ PostgreSQL
# ============================================================

FIRECRAWL_POSTGRES_USER=firecrawl

# Generate a strong password
FIRECRAWL_POSTGRES_PASSWORD=CHANGE_ME

# IMPORTANT:
# Keep this as "postgres".
# Firecrawl's current NuQ pg_cron configuration expects it.
FIRECRAWL_POSTGRES_DB=postgres

FIRECRAWL_POSTGRES_HOST=firecrawl-nuq-postgres

FIRECRAWL_POSTGRES_PORT=5432


# ============================================================
# Firecrawl RabbitMQ
# ============================================================

FIRECRAWL_RABBITMQ_USER=firecrawl

# Prefer letters/numbers to avoid URL-encoding problems here
FIRECRAWL_RABBITMQ_PASSWORD=CHANGE_ME_TO_LONG_RANDOM_PASSWORD

FIRECRAWL_RABBITMQ_URL=amqp://${FIRECRAWL_RABBITMQ_USER}:${FIRECRAWL_RABBITMQ_PASSWORD}@firecrawl-rabbitmq:5672


# ============================================================
# Firecrawl Playwright
# ============================================================

FIRECRAWL_PLAYWRIGHT_PORT=3000

FIRECRAWL_PLAYWRIGHT_URL=http://firecrawl-playwright:3000/scrape

FIRECRAWL_PLAYWRIGHT_MAX_CONCURRENT_PAGES=2

FIRECRAWL_ALLOW_LOCAL_WEBHOOKS=false

FIRECRAWL_BLOCK_MEDIA=false


# ============================================================
# Firecrawl Workers / Concurrency
# ============================================================

# Conservative settings for a shared server.
# We can increase these later.
FIRECRAWL_NUM_WORKERS_PER_QUEUE=2

FIRECRAWL_CRAWL_CONCURRENT_REQUESTS=2

FIRECRAWL_MAX_CONCURRENT_JOBS=1

FIRECRAWL_BROWSER_POOL_SIZE=2

FIRECRAWL_HARNESS_STARTUP_TIMEOUT_MS=180000


# ============================================================
# Firecrawl Resource Limits
# ============================================================

# Small shared server: use one NuQ worker
FIRECRAWL_NUQ_WORKER_COUNT=1

# Firecrawl defaults to 0.8.
# Give the machine a little more usable headroom.
FIRECRAWL_MAX_CPU=0.95
FIRECRAWL_MAX_RAM=0.95